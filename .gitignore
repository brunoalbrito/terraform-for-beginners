# Local .terraform directories (providers, modules)
**/.terraform/*

# State files (may contain secrets)
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Variable files (often contain secrets)
*.tfvars
*.tfvars.json

# Override files (local-only tweaks)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Saved plan files
*.tfplan
tfplan

# CLI config
.terraformrc
terraform.rc

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Keep the provider lock file committed
!.terraform.lock.hcl
